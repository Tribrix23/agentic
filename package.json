{
  "name": "quantix-coder",
  "productName": "Quantix Code",
  "version": "1.5.3",
  "description": "QUANTIX CODE is an AI-powered Electron desktop coding assistant featuring multi-model support, agentic tool execution, full IDE capabilities, terminal integration, Git operations, and premium UI for enhanced pair programming experiences.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/install-playwright-browser.mjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/install-playwright-browser.mjs",
    "package": "electron-forge package",
    "make": "npm run package && electron-builder --prepackaged \"out/Quantix Code-win32-x64\" --win nsis --x64",
    "make:linux": "npm run package && electron-builder --prepackaged \"out/Quantix Code-linux-x64\" --linux",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx src",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "node scripts/install-playwright-browser.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint"
  },
  "keywords": [],
  "author": {
    "name": "John David L. Perez",
    "email": "tribrix23@gmail.com"
  },
  "license": "Proprietary",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.20",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/mcp": "0.0.79",
    "@supabase/supabase-js": "^2.110.7",
    "@types/prismjs": "^1.26.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.42.2",
    "katex": "^0.18.5",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "p-limit": "^7.3.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "xterm": "^5.3.0"
  },
  "build": {
    "appId": "com.tribrix.quantixcode.app",
    "productName": "Quantix Code",
    "artifactName": "Quantix-Code-${version}-Setup.${ext}",
    "directories": {
      "output": "out/installer"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quantix Code",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "assets/license.txt",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": [
          "py",
          "ipynb",
          "json",
          "md",
          "txt",
          "yaml",
          "yml"
        ],
        "name": "Quantix Source File",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
